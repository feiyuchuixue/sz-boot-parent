<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sz</groupId>
    <artifactId>sz-boot-parent</artifactId>
    <packaging>pom</packaging>

    <parent>
        <groupId>com.sz</groupId>
        <artifactId>sz-build</artifactId>
        <version>${revision}</version>
        <relativePath>./sz-build/pom.xml</relativePath>
    </parent>

    <modules>
        <module>sz-common</module>
        <module>sz-module</module>
        <module>sz-service</module>
    </modules>

    <!--配置全局属性-->
    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <skipTests>true</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块版本统一收敛，子模块新增依赖时优先省略 version。 -->
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-db-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-db-mysql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-db-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-db-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-db-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz.wechat</groupId>
                <artifactId>sz-common-wechat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz.excel</groupId>
                <artifactId>sz-common-excel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz.oss</groupId>
                <artifactId>sz-common-oss</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz.resource</groupId>
                <artifactId>sz-common-resource</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-module-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-module-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-module-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-module-generator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-service-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sz</groupId>
                <artifactId>sz-service-websocket</artifactId>
                <version>${project.version}</version>
            </dependency>
</dependencies>
    </dependencyManagement>

