<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- sys_export_info: framework struct (MySQL) -->
    <changeSet id="framework-struct-sys-export-info-202605100838" author="升职哦（sz）" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_export_info"/></not>
        </preConditions>
        <createTable tableName="sys_export_info" remarks="导出信息">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="file_name" type="VARCHAR(32)" remarks="导出的文件名称"/>
            <column name="export_status_cd" type="VARCHAR(10)" defaultValue="" remarks="导出状态,关联字典表export_status"/>
            <column name="create_id" type="BIGINT" remarks="创建人ID"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" remarks="创建时间"/>
        </createTable>
    </changeSet>

    <!-- sys_export_info: framework struct (PostgreSQL) -->
    <changeSet id="framework-struct-sys-export-info-pg-202605100838" author="升职哦（sz）" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_export_info"/></not>
        </preConditions>
        <createTable tableName="sys_export_info" remarks="导出信息">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="file_name" type="VARCHAR(32)" remarks="导出的文件名称"/>
            <column name="export_status_cd" type="VARCHAR(10)" defaultValue="" remarks="导出状态,关联字典表export_status"/>
            <column name="create_id" type="BIGINT" remarks="创建人ID"/>
            <column name="create_time" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="创建时间"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
