<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- sys_user_role: framework struct + init -->
<changeSet  id="framework-struct-sys-user-role-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_user_role"/></not>
        </preConditions>
        <createTable tableName="sys_user_role" remarks="系统用户-角色关联表">
            <column name="user_id" type="BIGINT" remarks="用户ID(sys_user_id)"><constraints nullable="false"/></column>
            <column name="role_id" type="BIGINT" remarks="角色ID (sys_role_id)"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="sys_user_role" columnNames="user_id,role_id" constraintName="pk_sys_user_role"/>
        <createIndex tableName="sys_user_role" indexName="idx_user_role_role_id">
            <column name="role_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="framework-init-sys-user-role-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM sys_user_role</sqlCheck>
        </preConditions>
        <insert tableName="sys_user_role">
            <column name="role_id" valueNumeric="1"/>
            <column name="user_id" valueNumeric="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>
