    <!-- sys_dict: framework struct + init -->
    <changeSet id="framework-struct-sys-dict-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_dict"/></not>
        </preConditions>
        <createTable tableName="sys_dict" remarks="字典表">
            <column name="id" type="BIGINT" remarks="字典ID(规则)"><constraints primaryKey="true"/></column>
            <column name="sys_dict_type_id" type="BIGINT" remarks="关联sys_dict_type ID"><constraints nullable="false"/></column>
            <column name="code_name" type="VARCHAR(64)" remarks="字典名称"><constraints nullable="false"/></column>
            <column name="alias" type="VARCHAR(64)" defaultValue="" remarks="字典（Key）别名，某些情况下如果不想使用id作为key"><constraints nullable="false"/></column>
            <column name="sort" type="INT" remarks="排序(正序)"><constraints nullable="false"/></column>
            <column name="callback_show_style" type="VARCHAR(255)" remarks="回显样式"/>
            <column name="remark" type="VARCHAR(255)" defaultValue="" remarks="备注"><constraints nullable="false"/></column>
            <column name="is_lock" type="${bool.type}" defaultValue="F" remarks="是否锁定"><constraints nullable="false"/></column>
            <column name="is_show" type="${bool.type}" defaultValue="T" remarks="是否展示"><constraints nullable="false"/></column>
            <column name="del_flag" type="${bool.type}" defaultValue="F" remarks="是否删除"><constraints nullable="false"/></column>
            <column name="create_time" type="${datetime.type}" remarks="创建时间"/>
            <column name="update_time" type="${datetime.type}" remarks="更新时间"/>
            <column name="delete_time" type="${datetime.type}" remarks="删除时间"/>
            <column name="create_id" type="BIGINT" remarks="创建人ID"/>
            <column name="update_id" type="BIGINT" remarks="更新人ID"/>
            <column name="delete_id" type="BIGINT" remarks="删除人ID"/>
        </createTable>
    </changeSet>

