<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- sys_dept_leader: framework struct + init -->
<changeSet  id="framework-struct-sys-dept-leader-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_dept_leader"/></not>
        </preConditions>
        <createTable tableName="sys_dept_leader" remarks="部门领导人表">
            <column name="dept_id" type="BIGINT" remarks="部门ID"><constraints nullable="false"/></column>
            <column name="leader_id" type="BIGINT" remarks="领导人ID（sys_user_id）"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="sys_dept_leader" columnNames="dept_id,leader_id" constraintName="pk_sys_dept_leader"/>
        <createIndex tableName="sys_dept_leader" indexName="idx_dept_leader_leader_id">
            <column name="leader_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
