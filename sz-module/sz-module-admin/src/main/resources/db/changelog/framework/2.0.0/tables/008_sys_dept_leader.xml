<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- sys_dept_leader: framework struct + init -->
<changeSet  id="framework-struct-sys-dept-leader-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_dept_leader"/></not>
        </preConditions>
        <createTable tableName="sys_dept_leader" remarks="部门领导人表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="部门领导人ID"><constraints primaryKey="true"/></column>
            <column name="dept_id" type="INT" remarks="部门ID"/>
            <column name="leader_id" type="BIGINT" remarks="领导人ID（sys_user_id）"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
