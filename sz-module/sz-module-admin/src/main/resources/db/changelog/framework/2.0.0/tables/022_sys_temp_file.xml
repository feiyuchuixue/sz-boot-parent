<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="bool.type"     value="CHAR(1)"    dbms="mysql"/>
    <property name="bool.type"     value="VARCHAR(1)" dbms="postgresql"/>
    <property name="datetime.type" value="DATETIME"   dbms="mysql"/>
    <property name="datetime.type" value="TIMESTAMP"  dbms="postgresql"/>

    <!-- sys_temp_file: framework struct + init -->
    <changeSet id="framework-struct-sys-temp-file-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_temp_file"/></not>
        </preConditions>
        <createTable tableName="sys_temp_file" remarks="模版文件表">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="sys_file_id" type="BIGINT" remarks="文件ID"/>
            <column name="temp_name" type="VARCHAR(255)" defaultValue="" remarks="模版名"/>
            <column name="remark" type="VARCHAR(255)" defaultValue="" remarks="备注"/>
            <column name="del_flag" type="${bool.type}" remarks="逻辑删除"/>
            <column name="create_id" type="BIGINT" remarks="创建人"/>
            <column name="create_time" type="${datetime.type}" remarks="创建时间"/>
            <column name="update_id" type="BIGINT" remarks="更新人"/>
            <column name="update_time" type="${datetime.type}" remarks="更新时间"/>
            <column name="url" type="TEXT" remarks="地址(JSON数组对象)"/>
            <column name="alias" type="VARCHAR(64)" defaultValue="" remarks="标识，唯一"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
