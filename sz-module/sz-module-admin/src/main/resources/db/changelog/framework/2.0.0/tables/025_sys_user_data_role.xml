<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- sys_user_data_role: framework struct + init -->
<changeSet  id="framework-struct-sys-user-data-role-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_user_data_role"/></not>
        </preConditions>
        <createTable tableName="sys_user_data_role" remarks="系统用户-数据角色关联表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="用户-数据角色关联ID"><constraints primaryKey="true"/></column>
            <column name="role_id" type="BIGINT" remarks="数据角色ID (sys_data_role_id)"/>
            <column name="user_id" type="BIGINT" remarks="用户ID(sys_user_id)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
