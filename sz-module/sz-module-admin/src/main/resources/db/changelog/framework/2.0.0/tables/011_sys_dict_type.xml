    <!-- sys_dict_type: framework struct + init -->
    <changeSet id="framework-struct-sys-dict-type-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_dict_type"/></not>
        </preConditions>
        <createTable tableName="sys_dict_type" remarks="字典类型">
            <column name="id" type="BIGINT" remarks="字典类型ID"><constraints primaryKey="true"/></column>
            <column name="type_name" type="VARCHAR(64)" defaultValue="" remarks="字典类型名(中文)"><constraints nullable="false"/></column>
            <column name="type_code" type="VARCHAR(64)" remarks="字典类型码(英文)"><constraints nullable="false"/></column>
            <column name="is_lock" type="${bool.type}" defaultValue="F" remarks="是否锁定，锁定的属性无法在页面进行修改"/>
            <column name="is_show" type="${bool.type}" defaultValue="T" remarks="显示与否"/>
            <column name="del_flag" type="${bool.type}" defaultValue="F" remarks="删除与否"/>
            <column name="source_code" type="VARCHAR(64)" defaultValue="" remarks="所属来源"/>
            <column name="remark" type="VARCHAR(255)" defaultValue="" remarks="描述"/>
            <column name="create_time" type="${datetime.type}" remarks="创建时间"/>
            <column name="update_time" type="${datetime.type}" remarks="更新时间"/>
            <column name="delete_time" type="${datetime.type}" remarks="删除时间"/>
            <column name="create_id" type="BIGINT" remarks="创建人ID"/>
            <column name="update_id" type="BIGINT" remarks="更新人ID"/>
            <column name="delete_id" type="BIGINT" remarks="删除人ID"/>
        </createTable>
    </changeSet>

