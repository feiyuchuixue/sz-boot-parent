    <!-- sys_role_menu: framework struct + init -->
<changeSet  id="framework-struct-sys-role-menu-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_role_menu"/></not>
        </preConditions>
        <createTable tableName="sys_role_menu" remarks="系统角色-菜单表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="系统角色-菜单ID"><constraints primaryKey="true"/></column>
            <column name="menu_id" type="VARCHAR(32)" remarks="sys_menu_id （菜单表）"><constraints nullable="false"/></column>
            <column name="role_id" type="BIGINT" remarks="sys_role_id （角色表）"/>
            <column name="permission_type" type="ENUM('menu','scope')" defaultValue="menu" remarks="权限类型（功能权限；数据权限）"/>
            <column name="data_scope_cd" type="VARCHAR(255)" remarks="数据权限范围，data_scope字典"/>
        </createTable>
    </changeSet>

