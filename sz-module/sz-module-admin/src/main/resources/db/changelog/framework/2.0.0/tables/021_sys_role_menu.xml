<changeSet  id="framework-struct-sys-role-menu-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="sys_role_menu"/></not>
        </preConditions>
        <createTable tableName="sys_role_menu" remarks="系统角色-菜单表">
            <column name="role_id" type="BIGINT" remarks="sys_role_id （角色表）"><constraints nullable="false"/></column>
            <column name="permission_type" type="VARCHAR(10)" defaultValue="menu" remarks="权限类型（功能权限；数据权限）"><constraints nullable="false"/></column>
            <column name="menu_id" type="BIGINT" remarks="sys_menu_id （菜单表）"><constraints nullable="false"/></column>
            <column name="data_scope_cd" type="VARCHAR(255)" defaultValue="" remarks="数据权限范围，data_scope字典"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="sys_role_menu" columnNames="role_id,permission_type,menu_id,data_scope_cd" constraintName="pk_sys_role_menu"/>
    </changeSet>

