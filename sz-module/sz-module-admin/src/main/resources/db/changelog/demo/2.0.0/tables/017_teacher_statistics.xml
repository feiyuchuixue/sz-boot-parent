<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- teacher_statistics: demo data -->
    <changeSet id="demo-struct-teacher-statistics-202605100838" author="升职哦（sz）">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="teacher_statistics"/></not>
        </preConditions>
        <createTable tableName="teacher_statistics" remarks="教师统计总览表">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="ID"><constraints primaryKey="true"/></column>
            <column name="year" type="VARCHAR(4)" remarks="统计年限"><constraints nullable="false"/></column>
            <column name="month" type="VARCHAR(2)" remarks="统计月份"><constraints nullable="false"/></column>
            <column name="during_time" type="VARCHAR(10)" remarks="统计年月"/>
            <column name="teacher_id" type="VARCHAR(32)" remarks="教师id"><constraints nullable="false"/></column>
            <column name="teacher_common_type" type="INT" remarks="讲师区分类型"><constraints nullable="false"/></column>
            <column name="total_teaching" type="INT" remarks="授课总数"/>
            <column name="total_class_count" type="INT" remarks="服务班次数"/>
            <column name="total_hours" type="DECIMAL(10,2)" remarks="课时总数"/>
            <column name="check_status" type="INT" defaultValueNumeric="0" remarks="核对状态"><constraints nullable="false"/></column>
            <column name="check_time" type="DATETIME" remarks="核对时间"/>
            <column name="last_sync_time" type="DATETIME" remarks="最近一次同步时间"/>
            <column name="remark" type="VARCHAR(255)" remarks="备注"/>
            <column name="create_id" type="BIGINT" remarks="创建人ID"/>
            <column name="create_time" type="DATETIME" remarks="生成时间"/>
            <column name="update_id" type="BIGINT" remarks="更新人ID"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"/>
            <column name="dept_scope" type="JSON" remarks="部门范围"/>
            <column name="url" type="JSON" remarks="文件地址(JSON)"/>
            <column name="content_html" type="MEDIUMTEXT" remarks="内容HTML"/>
            <column name="has_invalid" type="ENUM('T','F')" defaultValue="F" remarks="是否无效（枚举情况演示字段，包含mf枚举使用，excel枚举处理）"/>
        </createTable>
    </changeSet>

