    <!--
      仅修复官方 demo 附件数据，不变更表结构，不执行任意业务资源的自动迁移。
      使用通用 insert/update 和两库内建 MD5，同时适用于 MySQL、PostgreSQL。
      MD5 仅用于识别原始 url 文本（避免 MySQL 不区分大小写的比较），不用于鉴权。
      用户已改附件、资源 ID/路径已占用时 MARK_RAN，
      保留现有数据，由管理员核对后重新上传/关联，不覆盖、不复活已删除资源。
      每条教师记录的资源登记和引用回填在同一事务中执行，避免只补一半。
      文件仍需随 data 目录部署；本脚本不创建文件，size 来自官方 demo 文件，create_time 为登记时间。
      数据回退需使用迁移前备份，不提供可能删除已被其他业务引用资源的自动 rollback。
    -->

    <changeSet id="demo-teacher-25-resource-references-20260904" author="sz" runInTransaction="true">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <sqlCheck expectedResult="1"><![CDATA[SELECT COUNT(*) FROM teacher_statistics WHERE id = 25 AND create_id = 4 AND MD5(url) = 'adc599bd6f2949f3b11abca386b93078']]></sqlCheck>
            <sqlCheck expectedResult="0"><![CDATA[
                SELECT COUNT(*) FROM sys_resource
                WHERE id IN (407693840624005121, 407693840624005122, 407693840624005123)
                   OR (scene_code = 'teacher.attachment' AND object_key IN ('teacher-attachments/template/teacher/20251021/bg1.png', 'teacher-attachments/template/teacher/20251021/bg7.png', 'teacher-attachments/template/teacher/20251021/bg10.png'))
            ]]></sqlCheck>
        </preConditions>
        <insert tableName="sys_resource">
            <column name="id" valueNumeric="407693840624005121"/>
            <column name="scene_code" value="teacher.attachment"/>
            <column name="object_key" value="teacher-attachments/template/teacher/20251021/bg1.png"/>
            <column name="origin_name" value="bg1.png"/>
            <column name="size" valueNumeric="105636"/>
            <column name="content_type" value="image/png"/>
            <column name="storage_type" value="LOCAL"/>
            <column name="del_flag" value="F"/>
            <column name="create_id" valueNumeric="4"/>
            <column name="create_time" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="sys_resource">
            <column name="id" valueNumeric="407693840624005122"/>
